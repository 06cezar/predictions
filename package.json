{
  "name": "predictions",
  "version": "1.0.0",
  "private": true,
  "description": "A social prediction game: friends predict each other's year, rate how bold each prediction is, then reveal what came true.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build && cd .. && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tests/tsconfig.json && cd client && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset.ts"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "connect-sqlite3": "^0.9.15",
    "drizzle-orm": "^0.30.8",
    "express": "^4.18.3",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.18.0",
    "nanoid": "^3.3.7",
    "tsx": "^4.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.9",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.11.28",
    "@types/supertest": "^6.0.2",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "supertest": "^6.3.4",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^1.4.0"
  }
}
