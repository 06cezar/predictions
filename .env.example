# Copy to .env (or set as Fly.io secrets) - never commit real values.

# Required in production: signs the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Seeds the first admin user when the users table is empty.
ADMIN_TOKEN=pick-a-hard-to-guess-token
ADMIN_NAME=Admin

# Optional
PORT=3011
# Where predictions.db and sessions.db live (default: /data in production, project root otherwise).
# DATA_DIR=./data
