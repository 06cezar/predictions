# Copy to .env (or set as Fly.io secrets) - never commit real values.

# Required in production: signs the session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# On a fresh install, create a first game and its admin. Anyone can also
# create games from the start page, so these are optional.
# ADMIN_TOKEN=pick-a-hard-to-guess-token
# ADMIN_NAME=Admin
# ADMIN_GAME_NAME=Predictions

# Name given to the existing game when a single-game database is upgraded (migration v2).
# LEGACY_GAME_NAME=Predictions

# Optional
PORT=3011
# Where predictions.db and sessions.db live (default: /data in production, project root otherwise).
# DATA_DIR=./data
